{
  "name": "dexterity-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Dexterity Connect: offline-first office messenger for the Dexterity LAN",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/hub/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "hub": "node apps/hub/src/main.ts",
    "hub:build": "npm run build -w @dex/hub",
    "desktop:dev": "npm run dev -w @dex/desktop",
    "desktop:build": "npm run build -w @dex/desktop",
    "desktop:dist": "npm run dist -w @dex/desktop"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
