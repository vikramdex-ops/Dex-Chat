{
  "name": "@dex/desktop",
  "productName": "Dexterity Connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dexterity Connect desktop app",
  "author": "Dexterity Design Services Pvt. Ltd.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@dex/core": "*",
    "@fontsource-variable/outfit": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "in.co.dexteritydesign.connect",
    "productName": "Dexterity Connect",
    "copyright": "\u00a9 Dexterity Design Services Pvt. Ltd.",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/badge.png",
        "to": "badge.png"
      }
    ],
    "protocols": [
      {
        "name": "Dexterity Connect",
        "schemes": [
          "dexconnect"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "DexterityConnect-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dexterity Connect",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "DexterityConnect-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "artifactName": "DexterityConnect-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dexterity Connect uses the microphone for calls with colleagues.",
        "NSCameraUsageDescription": "Dexterity Connect uses the camera for video calls with colleagues."
      }
    },
    "dmg": {
      "title": "Dexterity Connect"
    },
    "publish": null
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "jsqr": "^1.4.0",
    "mediasoup-client": "^3.26.0"
  }
}
