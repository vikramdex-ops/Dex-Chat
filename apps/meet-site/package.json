{
  "name": "@dex/meet-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dexterity Meet: the office's meeting site on Cloudflare Pages, a clean front door to the gateway",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler pages dev",
    "deploy": "node scripts/build.mjs && wrangler pages deploy",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "esbuild": "^0.28.2",
    "wrangler": "^4.162.0"
  }
}
