<!-- Windows service definition for the Dexterity Connect Hub (run by WinSW).
     Install-Hub.ps1 writes the data folder into DEXCONNECT_DATA_DIR (an absolute path) and also sets
     delayed automatic start and the three restarts with sc.exe, so they hold whatever WinSW does. -->
<service>
  <id>DexterityConnectHub</id>
  <name>Dexterity Connect Hub</name>
  <description>Office hub for Dexterity Connect: people, messages, files and calls on the local network. Works without internet.</description>
  <executable>%BASE%\DexterityConnectHub.exe</executable>
  <env name="DEXCONNECT_DATA_DIR" value="%BASE%\hub-data" />
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="20 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
